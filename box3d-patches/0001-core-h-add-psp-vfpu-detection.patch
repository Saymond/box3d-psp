Subject: [PATCH] Add B3_CPU_PSP / B3_SIMD_VFPU detection for PSP (Allegrex MIPS + VFPU)
---
Adds a new CPU/SIMD path for the Sony PSP's Allegrex CPU. The Allegrex is a
MIPS R4000 derivative with a Vector Floating Point Unit (VFPU). The new
B3_SIMD_VFPU path lets the shim in simd_vfpu.h take over from SSE2/NEON.

diff --git a/src/core.h b/src/core.h
--- a/src/core.h
+++ b/src/core.h
@@ -32,6 +32,8 @@
 #elif defined( __EMSCRIPTEN__ )
 	#define B3_PLATFORM_WASM
+#elif defined( __psp__ ) || defined( __PSP__ )
+	#define B3_PLATFORM_PSP
 #else
 	#define B3_PLATFORM_UNKNOWN
 #endif

@@ -43,11 +45,17 @@
 	#define B3_CPU_X86_X64
 #elif defined( __aarch64__ ) || defined( _M_ARM64 ) || defined( __arm__ ) || defined( _M_ARM )
 	#define B3_CPU_ARM
+#elif defined( __mips__ )
+	#define B3_CPU_PSP
+	#define B3_CPU_MIPS
 #elif defined( __EMSCRIPTEN__ )
 	#define B3_CPU_WASM
 #else
 	#define B3_CPU_UNKNOWN
 #endif

 #if defined( BOX3D_DISABLE_SIMD )
 	#define B3_SIMD_NONE
@@ -55,6 +63,9 @@
 	#if defined( B3_CPU_X86_X64 )
 		#define B3_SIMD_SSE2
 		#define B3_SIMD_WIDTH 4
+	#elif defined( B3_CPU_PSP )
+		#define B3_SIMD_VFPU
+		#define B3_SIMD_WIDTH 4
 	#elif defined( B3_CPU_ARM )
 		#define B3_SIMD_NEON
 		#define B3_SIMD_WIDTH 4
